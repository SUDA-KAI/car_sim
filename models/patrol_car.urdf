<?xml version='1.0' encoding='utf-8'?>
<robot name="patrol_car">
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0179414366925 5.04692134678e-08 0.259601471709" rpy="0 0 0" />
      <mass value="97.9" />
      <inertia ixx="12.7171007394" ixy="2.54265333296e-08" ixz="-0.0569321259533" iyy="15.2067949944" iyz="2.2980779105e-07" izz="24.8482602506" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="meshes/car_body_m.stl" />
      </geometry>
      <material name="body_blue">
        <color rgba="0.12 0.45 0.7 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.39" rpy="0 0 0" />
      <geometry>
        <box size="1.2 0.7 0.21" />
      </geometry>
    </collision>
  </link>
  <link name="rear_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.00541666666667" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.00541666666667" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius="0.2" length=".1" />
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_roll" type="continuous">
    <parent link="base_link" />
    <child link="rear_left_wheel" />
    <origin xyz="-0.45 0.4 0.2" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.05" friction="0.0" />
  </joint>
  <gazebo reference="rear_left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <link name="rear_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.00541666666667" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.00541666666667" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius="0.2" length=".1" />
      </geometry>
    </collision>
  </link>
  <joint name="rear_right_roll" type="continuous">
    <parent link="base_link" />
    <child link="rear_right_wheel" />
    <origin xyz="-0.45 -0.4 0.2" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.05" friction="0.0" />
  </joint>
  <gazebo reference="rear_right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <link name="front_left_knuckle">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>
  <joint name="front_left_steer" type="revolute">
    <parent link="base_link" />
    <child link="front_left_knuckle" />
    <origin xyz="0.45 0.4 0.2" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.9290195886913645" upper="0.9290195886913645" effort="150" velocity="1.0" />
    <dynamics damping="0.05" friction="0.0" />
  </joint>
  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.00541666666667" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.00541666666667" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius="0.2" length=".1" />
      </geometry>
    </collision>
  </link>
  <joint name="front_left_roll" type="continuous">
    <parent link="front_left_knuckle" />
    <child link="front_left_wheel" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.05" friction="0.0" />
  </joint>
  <gazebo reference="front_left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <link name="front_right_knuckle">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>
  <joint name="front_right_steer" type="revolute">
    <parent link="base_link" />
    <child link="front_right_knuckle" />
    <origin xyz="0.45 -0.4 0.2" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.9290195886913645" upper="0.9290195886913645" effort="150" velocity="1.0" />
    <dynamics damping="0.05" friction="0.0" />
  </joint>
  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.00541666666667" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.00541666666667" />
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <cylinder radius="0.2" length=".1" />
      </geometry>
    </collision>
  </link>
  <joint name="front_right_roll" type="continuous">
    <parent link="front_right_knuckle" />
    <child link="front_right_wheel" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.05" friction="0.0" />
  </joint>
  <gazebo reference="front_right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <link name="laser_frame" />
  <joint name="laser_mount" type="fixed">
    <parent link="base_link" />
    <child link="laser_frame" />
    <origin xyz="0 0 0.85" rpy="0 0 0" />
  </joint>
  <gazebo>
    <plugin filename="ignition-gazebo-ackermann-steering-system" name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>rear_left_roll</left_joint>
      <right_joint>rear_right_roll</right_joint>
      <left_steering_joint>front_left_steer</left_steering_joint>
      <right_steering_joint>front_right_steer</right_steering_joint>
      <wheel_base>0.9</wheel_base>
      <wheel_separation>0.8</wheel_separation>
      <kingpin_width>0.8</kingpin_width>
      <wheel_radius>0.2</wheel_radius>
      <steering_limit>0.6981317007977318</steering_limit>
      <topic>/sim/cmd_vel</topic>
      <odom_topic>/sim/odom</odom_topic>
      <tf_topic>/sim/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <min_velocity>-0.2</min_velocity>
      <max_velocity>0.5</max_velocity>
    </plugin>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 .85 0 0 0</pose>
      <topic>/sim/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <ignition_frame_id>laser_frame</ignition_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle>
            <max_angle>3.141592653589793</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>25</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
</robot>